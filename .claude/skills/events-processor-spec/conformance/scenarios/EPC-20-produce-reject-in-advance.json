{
  "name": "EPC-20-produce-reject-in-advance",
  "id": "EPC-20",
  "description": "The broker rejects produce to the charged-in-advance topic for one record.",
  "rules": ["EP-L3", "EP-A7", "EP-P7"],
  "rbd": ["RBD-7"],
  "catalog": ["../fixtures/catalog-base.sql"],
  "defaults": {"organization_id": "11111111-1111-1111-1111-111111111111", "external_subscription_id": "sub_ext_1", "ingested_at": "$INGESTED_NOW", "properties": {}},
  "steps": [
    {"kafka_reject_produce": ["events_charged_in_advance"]},
    {"produce": [
      {"json": {"transaction_id": "f_adv", "code": "api_calls", "timestamp": "1759320000", "properties": {"amount": 1}}}
    ]},
    {"wait": "quiescent"},
    {"kafka_reject_produce": []},
    {"produce": [
      {"json": {"transaction_id": "n1", "code": "count_calls", "timestamp": "1759320000"}}
    ]},
    {"wait": "quiescent"}
  ]
}

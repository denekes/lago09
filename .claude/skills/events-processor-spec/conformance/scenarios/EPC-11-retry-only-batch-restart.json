{
  "name": "EPC-11-retry-only-batch-restart",
  "id": "EPC-11",
  "description": "Control: same database fault, nothing follows; a graceful restart re-reads from the last commit.",
  "rules": ["EP-B4", "EP-M1"],
  "rbd": ["RBD-2", "RBD-1"],
  "catalog": ["../fixtures/catalog-base.sql"],
  "defaults": {"organization_id": "11111111-1111-1111-1111-111111111111", "external_subscription_id": "sub_ext_1", "ingested_at": "$INGESTED_NOW", "properties": {}},
  "modes": ["db"],
  "db_fault_tables": ["subscriptions"],
  "steps": [
    {"produce": [
      {"json": {"transaction_id": "warm", "code": "count_calls", "timestamp": "1759320000"}}
    ]},
    {"wait": "quiescent"},
    {"db_fault": {"table": "subscriptions", "times": 1}},
    {"produce": [
      {"json": {"transaction_id": "f_retry", "code": "api_calls", "timestamp": "1759320000", "properties": {"amount": 1}}}
    ]},
    {"wait_db_fault_fired": "subscriptions"},
    {"wait": "quiescent"},
    {"restart": "TERM"},
    {"wait": "quiescent"}
  ]
}

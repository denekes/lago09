{
  "name": "EPC-14-retry-11h-pending",
  "id": "EPC-14",
  "description": "Same database fault, ingested 11 h ago, nothing follows, no restart: the record stays uncommitted.",
  "rules": ["EP-B4", "EP-L1"],
  "rbd": ["RBD-1", "RBD-3"],
  "catalog": ["../fixtures/catalog-base.sql"],
  "defaults": {"organization_id": "11111111-1111-1111-1111-111111111111", "external_subscription_id": "sub_ext_1", "ingested_at": "$INGESTED_NOW", "properties": {}},
  "modes": ["db"],
  "db_fault_tables": ["subscriptions"],
  "steps": [
    {"produce": [
      {"json": {"transaction_id": "warm", "code": "count_calls", "timestamp": "1759320000"}}
    ]},
    {"wait": "quiescent"},
    {"db_fault": {"table": "subscriptions", "times": 1}},
    {"produce": [
      {"json": {"transaction_id": "f_pending", "code": "api_calls", "timestamp": "1759320000", "properties": {"amount": 1}, "ingested_at": "$INGESTED_11H_AGO"}}
    ]},
    {"wait_db_fault_fired": "subscriptions"},
    {"wait": "quiescent"}
  ]
}

{
  "name": "EPC-15-bm-db-fault",
  "id": "EPC-15",
  "description": "Transient database error on the billable-metric lookup (not a not-found): retryable; a later batch commits past it.",
  "rules": ["EP-E2", "EP-B3", "EP-B4"],
  "rbd": ["RBD-1"],
  "catalog": ["../fixtures/catalog-base.sql"],
  "defaults": {"organization_id": "11111111-1111-1111-1111-111111111111", "external_subscription_id": "sub_ext_1", "ingested_at": "$INGESTED_NOW", "properties": {}},
  "modes": ["db"],
  "db_fault_tables": ["billable_metrics"],
  "steps": [
    {"produce": [
      {"json": {"transaction_id": "warm", "code": "count_calls", "timestamp": "1759320000"}}
    ]},
    {"wait": "quiescent"},
    {"db_fault": {"table": "billable_metrics", "times": 1}},
    {"produce": [
      {"json": {"transaction_id": "f_bm", "code": "api_calls", "timestamp": "1759320000", "properties": {"amount": 1}}}
    ]},
    {"wait_db_fault_fired": "billable_metrics"},
    {"wait": "quiescent"},
    {"produce": [
      {"json": {"transaction_id": "n1", "code": "count_calls", "timestamp": "1759320000"}}
    ]},
    {"wait": "quiescent"}
  ]
}

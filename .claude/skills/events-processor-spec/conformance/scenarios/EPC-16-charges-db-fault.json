{
  "name": "EPC-16-charges-db-fault",
  "id": "EPC-16",
  "description": "Transient database error on the pay-in-advance charge lookup after the enriched record was produced; a later batch commits.",
  "rules": ["EP-J3", "EP-B4"],
  "rbd": ["RBD-8"],
  "catalog": ["../fixtures/catalog-base.sql"],
  "defaults": {"organization_id": "11111111-1111-1111-1111-111111111111", "external_subscription_id": "sub_ext_1", "ingested_at": "$INGESTED_NOW", "properties": {}},
  "modes": ["db"],
  "db_fault_tables": ["charges"],
  "steps": [
    {"produce": [
      {"json": {"transaction_id": "warm", "code": "count_calls", "timestamp": "1759320000", "external_subscription_id": "sub_ext_multi"}}
    ]},
    {"wait": "quiescent"},
    {"db_fault": {"table": "charges", "times": 1}},
    {"produce": [
      {"json": {"transaction_id": "f_charge", "code": "api_calls", "timestamp": "1759320000", "properties": {"amount": 1}}}
    ]},
    {"wait_db_fault_fired": "charges"},
    {"wait": "quiescent"},
    {"produce": [
      {"json": {"transaction_id": "n1", "code": "count_calls", "timestamp": "1759320000", "external_subscription_id": "sub_ext_multi"}}
    ]},
    {"wait": "quiescent"}
  ]
}

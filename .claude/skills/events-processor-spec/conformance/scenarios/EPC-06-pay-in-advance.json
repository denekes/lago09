{
  "name": "EPC-06-pay-in-advance",
  "id": "EPC-06",
  "description": "In-advance emission and the API-post-processed split.",
  "rules": ["EP-J1", "EP-J2", "EP-K1", "EP-H7", "EP-I2", "EP-W3"],
  "rbd": ["RBD-19", "RBD-20"],

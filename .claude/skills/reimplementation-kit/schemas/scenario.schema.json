{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "title": "kit scenario (kit_schema 1)",
  "description": "One end-to-end scenario file billing-engine-spec/scenarios/<id>.json, replayed by scripts/scenario-replay.py through the system.* ops (or --http). Normative prose: reference/scenario-tier.md. Placeholders {{var}} may appear in step paths, query values and body strings, and in setup bodies; variables come from setup auto-captures and step 'capture'/'bind'.",
  "type": "object",
  "required": ["kit_schema","id","area","title","profile","ruling","pair","rules","rbd","tags","evidence","setup","steps","expect"],
  "properties": {"kit_schema":{"const":1},"id":{"$ref":"common.schema.json#/$defs/scenario_id"},"area":{"const":"scn"},"title":{"type":"string","minLength":3,"maxLength":120},"profile":{"$ref":"common.schema.json#/$defs/profile"},"ruling":{"enum":["decided","proposed"]},"pair":{"anyOf":[{"type":"null"},{"$ref":"common.schema.json#/$defs/scenario_id"}]},"rules":{"type":"array","items":{"$ref":"common.schema.json#/$defs/rule_id"}},"rbd":{"type":"array","items":{"$ref":"common.schema.json#/$defs/rbd_id"}},"tags":{"type":"array","items":{"$ref":"common.schema.json#/$defs/tag"}},"evidence":{"$ref":"common.schema.json#/$defs/evidence"},"setup":{"$ref":"#/$defs/setup"},"steps":{"type":"array","items":{"$ref":"#/$defs/step"}},"expect":{"$ref":"#/$defs/snapshot_subset"},"compare":{"$ref":"#/$defs/compare"},"notes":{"type":"string"}},
  "additionalProperties": false,
  "$defs": {
    "setup": {"type":"object","required":["at","organization","premium","store"],"properties":{"at":{"$ref":"common.schema.json#/$defs/instant"},"organization":{"$ref":"#/$defs/tenant_settings"},"billing_entity":{"$ref":"#/$defs/tenant_settings"},"premium":{"type":"boolean"},"store":{"enum":["pg","ch"]},"taxes":{"type":"array","items":{"$ref":"#/$defs/create_body"}},"billable_metrics":{"type":"array","items":{"$ref":"#/$defs/create_body"}},"add_ons":{"type":"array","items":{"$ref":"#/$defs/create_body"}},"coupons":{"type":"array","items":{"$ref":"#/$defs/create_body"}},"plans":{"type":"array","items":{"$ref":"#/$defs/create_body"}},"customers":{"type":"array","items":{"$ref":"#/$defs/create_body"}}},"additionalProperties":false},
    "tenant_settings": {"description":"Tenant settings applied by system.reset. Absent keys take the defaults listed in scenario-tier.md section 3.","type":"object","properties":{"timezone":{"$ref":"common.schema.json#/$defs/timezone"},"default_currency":{"$ref":"common.schema.json#/$defs/currency"},"document_numbering":{"enum":["per_customer","per_billing_entity"]},"document_number_prefix":{"type":"string","pattern":"^[A-Z0-9-]{1,10}$"},"invoice_grace_period":{"type":"integer","minimum":0},"net_payment_term":{"type":"integer","minimum":0},"finalize_zero_amount_invoice":{"type":"boolean"},"premium_integrations":{"type":"array","items":{"type":"string","pattern":"^[a-z_]+$"}},"max_wallets":{"type":["integer","null"]},"clickhouse_deduplication_enabled":{"type":"boolean"},"document_locale":{"type":"string"},"eu_tax_management":{"type":"boolean"},"subscription_invoice_issuing_date_anchor":{"enum":["current_period_end","next_period_start"]},"subscription_invoice_issuing_date_adjustment":{"enum":["align_with_finalization_date","keep_anchor"]}},"additionalProperties":false},
    "create_body": {"description":"A REST v1 create body for the resource (without the root key), x-kit payload: number spellings are kept.","type":"object","x-kit-payload":true},
    "var_name": {"type":"string","pattern":"^[a-z][a-z0-9_]*(:[A-Za-z0-9_.-]+)*$"},
    "step": {"type":"object","required":["op"],"oneOf":[{"properties":{"op":{"const":"api"}},"required":["method","path"]},{"properties":{"op":{"const":"tick"}},"required":["jobs"],"not":{"anyOf":[{"required":["method"]},{"required":["path"]},{"required":["body"]},{"required":["query"]}]}},{"properties":{"op":{"const":"snapshot"}},"not":{"anyOf":[{"required":["method"]},{"required":["path"]},{"required":["jobs"]}]}}],"properties":{"at":{"$ref":"common.schema.json#/$defs/instant"},"op":{"enum":["api","tick","snapshot"]},"method":{"enum":["GET","POST","PUT","PATCH","DELETE"]},"path":{"type":"string","pattern":"^/api/v1/"},"query":{"type":"object","additionalProperties":{"type":["string","integer","boolean"]}},"body":{"type":"object","x-kit-payload":true},"jobs":{"type":"array","minItems":1,"items":{"enum":["billing","usage_update","refresh_drafts","finalize_drafts","wallet_refresh","overdue","terminate_ended","activate_subscriptions","terminate_coupons","terminate_wallets","interval_topups","termination_alerts","lifetime_usage","subscription_activity"]}},"bind":{"type":"object","additionalProperties":{"type":"object","required":["from","where"],"properties":{"from":{"enum":["invoices","invoices[*].fees","credit_notes","credit_notes[*].items","wallets","wallet_transactions","subscriptions","fees"]},"where":{"type":"object","x-kit-payload":true},"index":{"type":"integer","minimum":0},"pick":{"type":"string","pattern":"^[a-z_][a-z0-9_.]*$"}},"additionalProperties":false}},"capture":{"type":"object","additionalProperties":{"type":"string","pattern":"^[a-z_][a-z0-9_]*(\\.[a-z0-9_]+|\\[[0-9]+\\])*$"}},"expect":{"type":"object","x-kit-payload":true},"compare":{"$ref":"#/$defs/compare"},"note":{"type":"string"}},"additionalProperties":false},
    "snapshot_subset": {"description":"Subset of the system.snapshot output (API v1 serialisations); arrays are compared in order and with the same length unless compare says set.","type":"object","properties":{"invoices":{"type":"array","items":{"type":"object","x-kit-payload":true}},"credit_notes":{"type":"array","items":{"type":"object","x-kit-payload":true}},"wallets":{"type":"array","items":{"type":"object","x-kit-payload":true}},"wallet_transactions":{"type":"array","items":{"type":"object","x-kit-payload":true}},"subscriptions":{"type":"array","items":{"type":"object","x-kit-payload":true}},"fees":{"type":"array","items":{"type":"object","x-kit-payload":true}}},"additionalProperties":false},
    "compare": {"type":"object","additionalProperties":{"type":"object","required":["mode"],"properties":{"mode":{"enum":["exact","text","numeric","float64","abs_tol","range","instant","set","ignore","subset","strict"]},"scale":{"type":"integer","minimum":0,"maximum":40},"tol":{"$ref":"common.schema.json#/$defs/decimal"}},"additionalProperties":false}}
  }
}

{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"ops/aggregation.matching_and_ignored.schema.json","title":"aggregation.matching_and_ignored","description":"Matching values and ignored combinations of one bucket of a charge with filters (BE-AG-32..BE-AG-34). `selected` null = the default bucket. Value lists are sets.","x-kit":{"area":"aggregation","op":"matching_and_ignored","status":"final","since":"1.0.0","owner":"billing-engine-spec reference/04-aggregation-and-usage.md (BE-AG)","stateful":false},"$defs":{"input":{"type":"object","properties":{"metric_filters":{"type":"object","description":"Metric filter key -> declared values.","additionalProperties":{"type":"array","items":{"type":"string"}}},"charge_filters":{"type":"array","items":{"$ref":"#/$defs/charge_filter"}},"selected":{"type":["string","null"]}},"required":["metric_filters","charge_filters","selected"],"additionalProperties":false},"output":{"type":"object","properties":{"matching":{"type":"object","description":"key -> values","additionalProperties":{"type":"array","items":{"type":"string"}}},"ignored":{"type":"array","items":{"type":"object","description":"one ignored combination","additionalProperties":{"type":"array","items":{"type":"string"}}}}},"additionalProperties":true},"charge_filter":{"type":"object","required":["id","values"],"additionalProperties":false,"properties":{"id":{"type":"string"},"created_seq":{"type":"integer","default":0,"description":"Creation order (older = smaller)."},"updated_seq":{"type":"integer","x-kit-absent":"created_seq","description":"Last-update order; charge filters are listed by it."},"values":{"type":"object","additionalProperties":{"anyOf":[{"type":"array","items":{"type":"string"},"minItems":1},{"const":"ALL"}]},"description":"key -> allowed values, or \"ALL\" (every value the metric filter declares)."}}}}}

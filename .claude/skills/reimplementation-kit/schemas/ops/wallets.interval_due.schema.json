{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"ops/wallets.interval_due.schema.json","title":"wallets.interval_due","description":"Whether the interval top-up sweep run at `now` requests a top-up for one wallet's interval rule (BE-WL-28..31), and with which credits. Anniversary = local date of rule_started_at, else of the wallet creation, in the customer's effective zone. Start test (compat, RBD-105): the anchor's local wall-clock time is compared with `now` read as a UTC wall-clock time; corrected: compare instants.","x-kit":{"area":"wallets","op":"interval_due","status":"final","since":"1.0.0","owner":"billing-engine-spec reference/09-wallets.md (BE-WL)","stateful":false},"$defs":{"input":{"type":"object","properties":{"interval":{"enum":["weekly","monthly","quarterly","semiannual","yearly"]},"now":{"$ref":"../common.schema.json#/$defs/instant"},"wallet_created_at":{"$ref":"../common.schema.json#/$defs/instant"},"rule_started_at":{"$ref":"../common.schema.json#/$defs/instant","x-kit-absent":"the wallet creation instant is the anniversary"},"rule_expiration_at":{"$ref":"../common.schema.json#/$defs/instant","x-kit-absent":"never expires"},"timezone":{"$ref":"../common.schema.json#/$defs/timezone","x-kit-absent":"inherit the billing-entity zone"},"billing_entity_timezone":{"$ref":"../common.schema.json#/$defs/timezone","default":"UTC"},"interval_top_ups_at":{"type":"array","items":{"$ref":"../common.schema.json#/$defs/instant"},"description":"Creation instants of earlier interval top-ups of the wallet.","default":[]},"method":{"enum":["fixed","target"],"default":"fixed"},"paid_credits":{"$ref":"../common.schema.json#/$defs/decimal","default":"10"},"granted_credits":{"$ref":"../common.schema.json#/$defs/decimal","default":"0"},"target_ongoing_balance":{"$ref":"../common.schema.json#/$defs/decimal","x-kit-absent":"none"}},"additionalProperties":false,"required":["interval","now","wallet_created_at"]},"output":{"type":"object","properties":{"due":{"ty
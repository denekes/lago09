{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"ops/progressive.lifetime_usage.schema.json","title":"progressive.lifetime_usage","description":"Lifetime usage of a subscription (BE-PB-1..4): invoiced usage recomputed from the charge fees of its invoices, plus historical and current usage. `subscription` names which subscription an invoice belongs to relative to the measured one.","x-kit":{"area":"progressive","op":"lifetime_usage","status":"final","since":"1.0.0","owner":"billing-engine-spec reference/10-progressive-billing-and-alerts.md (BE-PB)","stateful":false},"$defs":{"input":{"type":"object","properties":{"historical_cents":{"$ref":"../common.schema.json#/$defs/cents","default":0},"current_cents":{"$ref":"../common.schema.json#/$defs/cents","default":0},"invoices":{"type":"array","items":{"type":"object","properties":{"status":{"enum":["draft","finalized","voided","failed","generating","open","pending","closed"],"default":"finalized"},"invoice_type":{"enum":["subscription","progressive_billing","add_on","one_off","credit","advance_charges"],"default":"subscription"},"subscription":{"enum":["self","predecessor","canceled","other_start","other_external_id"],"default":"self"},"fees":{"type":"array","items":{"type":"object","properties":{"fee_type":{"enum":["charge","subscription"],"default":"charge"},"amount_cents":{"$ref":"../common.schema.json#/$defs/cents"}},"additionalProperties":false,"required":["amount_cents"]},"default":[]}},"additionalProperties":false},"default":[]}},"additionalProperties":false},"output":{"type":"object","properties":{"invoiced_usage_cents":{"$ref":"../common.schema.json#/$defs/cents"},"total_cents":{"$ref":"../common.schema.json#/$defs/cents"}},"additionalProperties":true}}}

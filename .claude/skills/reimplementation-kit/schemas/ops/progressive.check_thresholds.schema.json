{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"ops/progressive.check_thresholds.schema.json","title":"progressive.check_thresholds","description":"Usage thresholds passed for a subscription (BE-PB-5..10). Thresholds are created on `attach`; plan_fixed_cents adds thresholds on the plan as well. Output: passed one-time thresholds ascending, and whether the recurring threshold passed.","x-kit":{"area":"progressive","op":"check_thresholds","status":"final","since":"1.0.0","owner":"billing-engine-spec reference/10-progressive-billing-and-alerts.md (BE-PB)","stateful":false},"$defs":{"input":{"type":"object","properties":{"fixed_cents":{"type":"array","items":{"type":"integer","minimum":1},"default":[]},"recurring_cents":{"$ref":"../common.schema.json#/$defs/cents","x-kit-absent":"no recurring threshold"},"attach":{"enum":["subscription","plan","parent_plan"],"default":"subscription"},"plan_fixed_cents":{"type":"array","items":{"type":"integer","minimum":1},"default":[]},"progressive_billing_disabled":{"type":"boolean","default":false},"historical_cents":{"$ref":"../common.schema.json#/$defs/cents","default":0},"invoiced_cents":{"$ref":"../common.schema.json#/$defs/cents","default":0},"current_cents":{"$ref":"../common.schema.json#/$defs/cents"},"progressively_billed_cents":{"$ref":"../common.schema.json#/$defs/cents","default":0}},"additionalProperties":false,"required":["current_cents"]},"output":{"type":"object","properties":{"passed_fixed_cents":{"type":"array","items":{"$ref":"../common.schema.json#/$defs/cents"}},"recurring_passed":{"type":"boolean"}},"additionalProperties":true}}}

{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"ops/credit_notes.termination.schema.json","title":"credit_notes.termination","description":"Automatic credit note at termination of a pay-in-advance subscription (BE-CN-15..18); null when none is created. The subscription fee has id sub_fee. `upgrade: true` with on_termination `refund` or `offset` is the reference's unhandled error: domain error `server_error` (BE-CN-18).","x-kit":{"area":"credit_notes","op":"termination","status":"final","since":"1.0.0","owner":"billing-engine-spec reference/08-credit-notes.md (BE-CN)","stateful":false},"$defs":{"input":{"type":"object","properties":{"currency":{"$ref":"../common.schema.json#/$defs/currency","default":"EUR"},"timezone":{"$ref":"../common.schema.json#/$defs/timezone","default":"UTC"},"terminated_at":{"$ref":"../common.schema.json#/$defs/instant"},"plan":{"type":"object","properties":{"interval":{"enum":["weekly","monthly","quarterly","semiannual","yearly"]},"amount_cents":{"$ref":"../common.schema.json#/$defs/cents"},"pay_in_advance":{"type":"boolean","default":true},"trial_period_days":{"$ref":"../common.schema.json#/$defs/decimal","default":"0"}},"additionalProperties":false,"required":["interval","amount_cents"]},"subscription":{"type":"object","properties":{"billing_time":{"enum":["calendar","anniversary"],"default":"calendar"},"started_at":{"$ref":"../common.schema.json#/$defs/instant"},"subscription_at":{"$ref":"../common.schema.json#/$defs/instant","x-kit-absent":"equal to started_at"}},"additionalProperties":false,"required":["started_at"]},"invoice":{"type":"object","properties":{"subscription_fee_amount_cents":{"$ref":"../common.schema.json#/$defs/cents"},"taxes":{"type":"array","items":{"$ref":"invoice.totals.schema.json#/$defs/tax"},"default":[]},"applied_coupons":{"type":"array","items":{"$ref":"invoice.totals.schema.json#/$defs/applied_coupon"},"default":[]},"other_fees":{"type":"array","items":{"$ref":"invoice.totals.schema.json#/$defs/fee"},"default":[]},"payment_status":{"enum":["pending","succeeded","failed"],"default":"pending"},"total_paid_amount_cents":{"$ref":"../common.schema.json#/$defs/cents","default":0},"status":{"enum":["finalized","voided"],"default":"finalized","description":"Status of the invoice that carries the last subscription fee (voided: no note, BE-CN-18)."}},"additionalProperties":false,"required":["subscription_fee_amount_cents"]},"previous_credit_notes":{"type":"array","items":{"$ref":"invoice.totals.schema.json#/$defs/cn_request"},"default":[]},"upgrade":{"type":"boolean","default":false},"on_termination":{"enum":["credit","refund","offset"],"default":"credit"}},"additionalProperties":false,"required":["terminated_at","plan","subscription","invoice"]},"output":{"type":"object","properties":{"credit_note":{"anyOf":[{"$ref":"credit_notes.compute.schema.json#/$defs/output"},{"type":"null"}],"description":"the automatic note (same fields as credit_notes.compute; its single item has fee_id sub_fee), or null when none is created (BE-CN-18)"}},"additionalProperties":true}}}

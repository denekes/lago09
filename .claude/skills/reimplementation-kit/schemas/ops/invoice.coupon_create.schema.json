{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"ops/invoice.coupon_create.schema.json","title":"invoice.coupon_create","description":"Creating a catalogue coupon (BE-IV-17): required values per type and frequency, limitation rules and the expiration check; the organization holds the plans and billable metrics named in `catalog`. Errors are domain errors (first error).","x-kit":{"area":"invoice","op":"coupon_create","status":"final","since":"1.0.0","owner":"billing-engine-spec reference/07-invoices-taxes-coupons.md (BE-IV)","stateful":false},"$defs":{"coupon":{"type":"object","required":["coupon_type","frequency"],"additionalProperties":false,"description":"Coupon parameters as the coupon API takes them.","properties":{"coupon_type":{"enum":["fixed_amount","percentage"]},"amount_cents":{"type":"integer","x-kit-absent":"no amount"},"amount_currency":{"$ref":"../common.schema.json#/$defs/currency","x-kit-absent":"no currency"},"percentage_rate":{"$ref":"../common.schema.json#/$defs/decimal","x-kit-absent":"no rate"},"frequency":{"enum":["once","recurring","forever"]},"frequency_duration":{"type":"integer","x-kit-absent":"no duration"},"reusable":{"type":"boolean","default":true},"expiration":{"enum":["no_expiration","time_limit"],"default":"no_expiration"},"expiration_at":{"$ref":"../common.schema.json#/$defs/instant","x-kit-absent":"no expiration instant"},"plan_codes":{"type":"array","items":{"type":"string"},"default":[],"description":"Plan limitation (codes)."},"billable_metric_codes":{"type":"array","items":{"type":"string"},"default":[],"description":"Billable-metric limitation (codes)."},"status":{"enum":["active","terminated"],"default":"active","description":"coupon_apply only: the catalogue coupon's status."}}},"input":{"type":"object","required":["coupon"],"additionalProperties":false,"properties":{"coupon":{"$ref":"#/$defs/coupon"},"catalog":{"type":"object","additionalProperties":false,"default":{},"description":"Plans and billable metrics
{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"ops/wallets.top_up.schema.json","title":"wallets.top_up","description":"One wallet-transaction request on a wallet (BE-WL-5..12): paid credits (pending purchased inbound, balance unchanged), granted credits (settled granted inbound, balance increased, optional consumed-credit reset) and voided credits (settled voided outbound, balance decreased), in that order; inputs are floored to 5 places. Output: the transactions created and the wallet balances afterwards, or a validation error {code, field}.","x-kit":{"area":"wallets","op":"top_up","status":"final","since":"1.0.0","owner":"billing-engine-spec reference/09-wallets.md (BE-WL)","stateful":false},"$defs":{"input":{"type":"object","properties":{"wallet":{"$ref":"wallets.allocate.schema.json#/$defs/wallet"},"paid_credits":{"type":"string","description":"Raw request value (decimal text; invalid text allowed).","x-kit-absent":"no paid credits"},"granted_credits":{"type":"string","x-kit-absent":"no granted credits"},"voided_credits":{"type":"string","x-kit-absent":"no voided credits"},"reset_consumed_credits":{"type":"boolean","default":false},"ignore_paid_top_up_limits":{"type":"boolean","default":false}},"additionalProperties":false,"required":["wallet"]},"output":{"type":"object","properties":{"transactions":{"type":"array","items":{"type":"object","properties":{"transaction_status":{"enum":["purchased","granted","voided","invoiced"]},"status":{"enum":["pending","settled","failed"]},"credit_amount":{"$ref":"../common.schema.json#/$defs/decimal"},"amount":{"$ref":"../common.schema.json#/$defs/decimal"},"amount_cents":{"$ref":"../common.schema.json#/$defs/cents"}},"additionalProperties":true}},"wallet":{"type":"object","properties":{"balance_cents":{"$ref":"../common.schema.json#/$defs/cents"},"credits_balance":{"$ref":"../common.schema.json#/$defs/decimal"},"consumed_credits":{"$ref":"../common.schema.json#/$defs/decimal"},"consumed_amount_cents":{"$ref":"../common.schema.json#/$defs/cents"}},"additionalProperties":true}},"additionalProperties":true}}}

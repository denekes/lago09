{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter-protocol.schema.json",
  "title": "kit adapter protocol v1 messages",
  "description": "One JSON object per line on the adapter's stdin (runner -> adapter: hello, call, bye) or stdout (adapter -> runner: hello, result). Normative prose: reference/adapter-protocol.md.",
  "oneOf": [
    {"$ref": "#/$defs/runner_hello"},
    {"$ref": "#/$defs/adapter_hello"},
    {"$ref": "#/$defs/call"},
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/bye"}
  ],
  "$defs": {
    "runner_hello": {
      "type": "object",
      "required": ["type", "proto", "kit_version", "kit_schema", "profiles", "areas"],
      "properties": {
        "type": {"const": "hello"},
        "role": {"const": "runner"},
        "proto": {"const": 1},
        "kit_version": {"type": "string"},
        "kit_schema": {"const": 1},
        "profiles": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/run_profile"}},
        "areas": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "adapter_hello": {
      "type": "object",
      "required": ["type", "proto", "impl", "impl_version", "profiles", "ops"],
      "properties": {
        "type": {"const": "hello"},
        "proto": {"const": 1},
        "impl": {"type": "string", "minLength": 1},
        "impl_version": {"type": "string"},
        "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/run_profile"}},
        "ops": {"type": "array", "items": {"type": "string", "pattern": "^(\\*|[a-z_]+\\.(\\*|[a-z0-9_]+))$"}}
      },
      "additionalProperties": true
    },
    "call": {
      "type": "object",
      "required": ["type", "id", "area", "op", "profile", "input"],
      "properties": {
        "type": {"const": "call"},
        "id": {"type": "string", "pattern": "^[a-z0-9_.]+x?#[0-9]+$"},
        "area": {"type": "string"},
        "op": {"type": "string"},
        "profile": {"$ref": "common.schema.json#/$defs/run_profile"},
        "input": {"type": "object"}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"const": "result"},
        "id": {"type": "string"},
        "output": {"type": "object"},
        "error": {
          "type": "object",
          "required": ["code"],
          "properties": {
            "code": {"type": "string", "minLength": 1, "description": "a domain error code of the reference (e.g. invalid_format), a kit domain code (charge_model_error, parse_error, evaluation_error) or a protocol code (unsupported_op, bad_input, internal)"},
            "field": {"type": "string"},
            "message": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "oneOf": [
        {"required": ["output"], "not": {"required": ["error"]}},
        {"required": ["error"], "not": {"required": ["output"]}}
      ],
      "additionalProperties": false
    },
    "bye": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "bye"}},
      "additionalProperties": false
    }
  }
}
